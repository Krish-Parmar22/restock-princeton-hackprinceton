# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://localhost:5432/pizza
GRABS_DIR=./grabs

# d1 (Liquid AI). D1_BACKEND = liquid | fake
D1_BACKEND=fake
LIQUID_API_KEY=

# Agent model (LangChain init_chat_model string), e.g. groq:openai/gpt-oss-120b or ollama:qwen3:8b
AGENT_MODEL=
FALLBACK_MODEL=anthropic:claude-sonnet-5-5
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=princeton-hacks

# Arnav's Photon bridge
BRIDGE_URL=http://localhost:8787
