# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://localhost:5432/pizza
GRABS_DIR=./grabs

# One OpenRouter key can run BOTH the agent model and d1:
#   AGENT_MODEL=openrouter:openai/gpt-oss-120b   and   D1_BACKEND=openrouter
OPENROUTER_API_KEY=

# d1 backend: openrouter | liquid | fake
D1_BACKEND=fake
LIQUID_API_KEY=

# Agent model: openrouter:openai/gpt-oss-120b, groq:openai/gpt-oss-120b, or ollama:qwen3:8b
AGENT_MODEL=
FALLBACK_MODEL=anthropic:claude-sonnet-5-5
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=princeton-hacks

# Arnav's Photon bridge
BRIDGE_URL=http://localhost:8787
