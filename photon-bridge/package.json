{
  "name": "photon-bridge",
  "private": true,
  "type": "module",
  "description": "Photon iMessage <-> agent API bridge. Contract: docs/arnav-shah.md",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "PHOTON_PROVIDER=terminal tsx --env-file-if-exists=.env src/index.ts",
