# Copy to photon-bridge/.env. Never commit .env.
# Photon 2.0 (app.beta.photon.codes): Settings > Project ID, and API keys (project:read + project:write)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# (SPECTRUM_PROJECT_ID / SPECTRUM_PROJECT_SECRET are read as fallbacks)
# imessage (default) | terminal (offline dev, no credentials)
PHOTON_PROVIDER=imessage
# Agent API (app/, owned by Krish)
API_URL=http://localhost:8000
BRIDGE_PORT=8787
# chats.json + inbox/ (owner photos) live here; gitignored
# BRIDGE_DATA_DIR=./data
